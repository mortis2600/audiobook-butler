# Where shelved books land (Author/Series/## - Title/)
AUDIOBOOK_LIB_DIR=./library

# Log file
LOG_FILE_PATH=./butler.log

# Ollama (local LLM for metadata extraction)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b

# qBittorrent (torrent name/file list used as metadata context)
QB_URL=http://127.0.0.1:8080
QB_USER=
QB_PASS=

# Google Books API key (optional; raises enrichment rate limits)
GOOGLE_BOOKS_API_KEY=

# Tag writer for m4b/m4a (mp3 uses mid3v2 from python-mutagen)
EXIFTOOL_PATH=exiftool
